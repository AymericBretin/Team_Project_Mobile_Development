<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules (Android < 12).
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Auth session is encrypted with a device-bound Keystore key: unreadable after a restore. -->
    <exclude domain="file" path="datastore/auth_session.pb" />
</full-backup-content>
