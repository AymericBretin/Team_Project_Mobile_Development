<?xml version="1.0" encoding="utf-8"?><!--
   Backup / device transfer rules (Android 12+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Auth session is encrypted with a device-bound Keystore key: unreadable after a restore. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/auth_session.pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth_session.pb" />
    </device-transfer>
</data-extraction-rules>
